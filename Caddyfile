# Bloc à ajouter au Caddyfile du reverse proxy déjà en place sur le VPS
# (celui du projet farmlink, /opt/farmlink), puis :
#
#   docker compose -f /opt/farmlink/docker-compose.yml exec caddy \
#     caddy reload --config /etc/caddy/Caddyfile
#
# `caddy reload` recharge la configuration sans couper une seule connexion :
# les sites déjà servis par ce proxy ne sont pas interrompus.
#
# Caddy demande et renouvelle seul le certificat, à condition que les DNS
# pointent vers ce VPS — c'est le cas : lenggroupe.bf → 76.13.44.239.

lenggroupe.bf {
	encode zstd gzip

	header {
		# Le navigateur refuse le HTTP en clair sur ce domaine pendant un an.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	# Nom du conteneur sur le réseau `proxy`. Caddy transmet l'IP réelle du
	# visiteur : les statistiques et la limitation des tentatives en dépendent.
	reverse_proxy lenggroupe_site:3000
}

www.lenggroupe.bf {
	redir https://lenggroupe.bf{uri} permanent
}
