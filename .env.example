# Copier en `.env` et compléter. Ce fichier-ci ne contient aucun secret.

# URL canonique du site : balises og:, sitemap, données structurées.
NUXT_PUBLIC_SITE_URL=https://lenggroupe.bf

# Identifiant Google Analytics. Laisser vide désactive complètement le script.
# Les statistiques du dashboard fonctionnent sans lui.
NUXT_PUBLIC_GTAG_ID=

# Mot de passe d'accès à /admin.
# S'il est défini, il fait foi à chaque démarrage — c'est aussi la façon de
# reprendre la main en cas de mot de passe perdu.
# S'il est absent, un mot de passe aléatoire est généré au premier lancement et
# affiché dans les logs du serveur.
NUXT_ADMIN_PASSWORD=

# Emplacement de la base et des photos téléversées.
# À placer HORS du dossier de déploiement en production, pour qu'une mise à
# jour du site n'efface ni les demandes reçues ni les images.
# Défaut : ./data
NUXT_DATA_DIR=

# Chemin du fichier SQLite, si vous voulez le dissocier du dossier ci-dessus.
# Défaut : <NUXT_DATA_DIR>/lenggroupe.sqlite
NUXT_DB_PATH=
